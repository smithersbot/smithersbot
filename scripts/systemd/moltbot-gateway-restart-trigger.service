[Unit]
Description=Restart gateway dev service from Telegram request files

[Service]
Type=oneshot
ExecStart=/bin/sh -lc 'set -eu; request_dirs="$HOME/.moltbot/telegram/gateway-restart/requests $HOME/.clawdbot/telegram/gateway-restart/requests"; has_requests=0; for request_dir in $request_dirs; do [ -d "$request_dir" ] || continue; if find "$request_dir" -maxdepth 1 -type f -name "*.req" -print -quit | grep -q .; then has_requests=1; break; fi; done; [ "$has_requests" -eq 1 ] || exit 0; systemctl --user restart moltbot-gateway-dev.service; for request_dir in $request_dirs; do [ -d "$request_dir" ] || continue; find "$request_dir" -maxdepth 1 -type f -name "*.req" -delete; done'
