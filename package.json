{
  "name": "smithersbot",
  "version": "2026.1.29",
  "description": "SmithersBot — a Telegram-controlled multi-agent goal execution harness.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin-sdk": "./dist/plugin-sdk/index.js",
    "./plugin-sdk/*": "./dist/plugin-sdk/*",
    "./cli-entry": "./smithersbot.mjs"
  },
  "bin": {
    "smithersbot": "./smithersbot.mjs"
  },
  "files": [
    "dist/acp/**",
    "dist/agents/**",
    "dist/auto-reply/**",
    "dist/browser/**",
    "dist/canvas-host/**",
    "dist/cli/**",
    "dist/commands/**",
    "dist/config/**",
    "dist/compat/**",
    "dist/control-ui/**",
    "dist/cron/**",
    "dist/channels/**",
    "dist/daemon/**",
    "dist/gateway/**",
    "dist/goal/worker-context/**",
    "dist/hooks/**",
    "dist/infra/**",
    "dist/media/**",
    "dist/media-understanding/**",
    "dist/link-understanding/**",
    "dist/process/**",
    "dist/plugins/**",
    "dist/plugin-sdk/**",
    "dist/prompts/**",
    "dist/security/**",
    "dist/sessions/**",
    "dist/providers/**",
    "dist/telegram/**",
    "dist/tui/**",
    "dist/tts/**",
    "dist/wizard/**",
    "dist/*.js",
    "dist/*.json",
    "extensions/memory-core/**",
    "extensions/telegram/**",
    "assets/**",
    "smithersbot.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/postinstall.js",
    "scripts/format-staged.js",
    "scripts/setup-git-hooks.js",
    "tools/git-hooks/**",
    "dist/terminal/**",
    "dist/routing/**",
    "dist/shared/**",
    "dist/utils/**",
    "dist/logging/**",
    "dist/memory/**",
    "dist/markdown/**",
    "dist/node-host/**",
    "dist/pairing/**"
  ],
  "scripts": {
    "dev": "node scripts/run-node.mjs",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json && node --import tsx scripts/canvas-a2ui-copy.ts && node --import tsx scripts/copy-hook-metadata.ts && node --import tsx scripts/copy-scout-template.ts && node --import tsx scripts/copy-worker-contract.ts && node --import tsx scripts/write-build-info.ts",
    "plugins:sync": "node --import tsx scripts/sync-plugin-versions.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "ui:install": "node scripts/ui.js install",
    "ui:dev": "node scripts/ui.js dev",
    "ui:build": "node scripts/ui.js build",
    "start": "node scripts/run-node.mjs",
    "gateway:watch": "node scripts/watch-node.mjs gateway --force",
    "gateway:dev": "MOLTBOT_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway",
    "gateway:dev:reset": "MOLTBOT_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway --reset",
    "tui": "node scripts/run-node.mjs tui",
    "tui:dev": "MOLTBOT_PROFILE=dev node scripts/run-node.mjs tui",
    "smithersbot:rpc": "node scripts/run-node.mjs agent --mode rpc --json",
    "lint": "oxlint --type-aware src test",
    "lint:fix": "pnpm format:fix && oxlint --type-aware --fix src test",
    "format": "oxfmt --check src test",
    "format:fix": "oxfmt --write src test",
    "test": "node scripts/test-parallel.mjs",
    "test:watch": "vitest",
    "test:ui": "pnpm --dir ui test",
    "test:force": "node --import tsx scripts/test-force.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "MOLTBOT_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "protocol:gen": "node --import tsx scripts/protocol-gen.ts",
    "check:loc": "node --import tsx scripts/check-ts-max-loc.ts --max 500"
  },
  "keywords": [
    "telegram",
    "bot",
    "agent",
    "assistant",
    "cli",
    "ai"
  ],
  "author": "Matthew Overing <contact@smithersbot.com>",
  "license": "MIT",
  "homepage": "https://smithersbot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithersbot/smithersbot.git"
  },
  "bugs": {
    "url": "https://github.com/smithersbot/smithersbot/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.13.1",
    "@aws-sdk/client-bedrock": "^3.975.0",
    "@buape/carbon": "0.14.0",
    "@clack/prompts": "^0.11.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@homebridge/ciao": "^1.3.4",
    "@lydell/node-pty": "1.2.0-beta.3",
    "@mariozechner/pi-agent-core": "0.49.3",
    "@mariozechner/pi-ai": "0.49.3",
    "@mariozechner/pi-coding-agent": "0.49.3",
    "@mariozechner/pi-tui": "0.49.3",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "0.34.47",
    "ajv": "^8.17.1",
    "body-parser": "^2.2.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "chromium-bidi": "13.0.1",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.2",
    "croner": "^9.1.0",
    "detect-libc": "^2.1.2",
    "discord-api-types": "^0.38.37",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "file-type": "^21.3.0",
    "grammy": "^1.39.3",
    "hono": "4.11.4",
    "jiti": "^2.6.1",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "long": "5.3.2",
    "markdown-it": "^14.1.0",
    "node-edge-tts": "^1.2.9",
    "osc-progress": "^0.3.0",
    "pdfjs-dist": "^5.4.530",
    "playwright-core": "1.58.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "sqlite-vec": "0.1.7-alpha.2",
    "tar": "7.5.4",
    "tslog": "^4.10.2",
    "undici": "^7.19.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "node-llama-cpp": "3.15.0"
  },
  "devDependencies": {
    "@grammyjs/types": "^3.23.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "lit": "^3.3.2",
    "lucide": "^0.563.0",
    "ollama": "^0.6.3",
    "oxfmt": "0.26.0",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "tar": "7.5.4"
  },
  "pnpm": {
    "minimumReleaseAge": 2880,
    "overrides": {
      "@sinclair/typebox": "0.34.47",
      "hono": "4.11.4",
      "tar": "7.5.4"
    }
  }
}
